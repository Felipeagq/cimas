# Copie este archivo a .env.local para desarrollo, o defina las variables en
# Amplify Console > Hosting > Environment variables. Todas son opcionales.
# Solo las variables NEXT_PUBLIC_* llegan al navegador y se fijan en el build.

# URL pública del sitio (canonical, sitemap y Open Graph). Por defecto: https://cimas-masoneria.com
# NEXT_PUBLIC_SITE_URL=https://cimas-masoneria.com

# Formulario de contacto. Sin endpoint, el formulario abre el correo del usuario
# dirigido a NEXT_PUBLIC_CONTACT_EMAIL (por defecto secretario@cimas-masoneria.com).
# Con endpoint, hace POST JSON {nombre, email, mensaje} (Formspree, API Gateway + Lambda/SES, etc.).
# NEXT_PUBLIC_CONTACT_EMAIL=secretario@cimas-masoneria.com
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://example.com/contacto
